# --- Broker Config ---
HTEQ__ALPACA_KEY_ID=your_key
HTEQ__ALPACA_SECRET_KEY=your_secret
HTEQ__ALPACA_BASE_URL=https://paper-api.alpaca.markets
HTEQ__ALPACA_DATA_URL=https://data.alpaca.markets/v2

# --- App Config ---
HTEQ__MODE=paper
HTEQ__STRATEGY=lgbm
HTEQ__WATCHLIST=AAPL,TSLA,MSFT
HTEQ__DRY_RUN=true

# --- Telegram ---
HTEQ__TELEGRAM_BOT_TOKEN=your_token
HTEQ__TELEGRAM_CHAT_ID=your_chat_id

# --- Risk Gates ---
HTEQ__TRADING_ENABLED=false
HTEQ__RISK_MAX_NOTIONAL_USD=1000
HTEQ__RISK_MAX_POSITIONS=5
# Live trading requires: HTEQ__ACK_LIVE="I_UNDERSTAND_REAL_MONEY"
HTEQ__ACK_LIVE=NONE

# --- Bundle & Trainer ---
HTEQ__MODEL_BUNDLE_PATH=/app/model_bundle
HTEQ__REQUIRE_MODEL_BUNDLE=false
HTEQ__TRAINER_MODE=service # service | once
HTEQ__TRAINER_INTERVAL_HOURS=24

# --- State ---
HTEQ__STATE_DB_PATH=/app/data/state.db

# --- Commercial ---
HTEQ__WHOP_LICENSE=PASTE_LICENSE_HERE
